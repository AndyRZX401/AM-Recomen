@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full glass rounded-3xl p-8 sm:p-10 text-center space-y-6 border border-white/10 shadow-2xl animate-fade-in">
        <div class="inline-flex p-5 bg-red-500/10 rounded-full text-red-500 border border-red-500/20">
            <i class="fa-solid fa-triangle-exclamation text-4xl"></i>
        </div>

        <div class="space-y-2">
            <h1 class="font-display font-extrabold text-3xl text-white">Algo salió mal</h1>
            <p class="text-gray-400 text-sm leading-relaxed">
                Ocurrió un error inesperado al procesar tu solicitud. Nuestro sistema ha registrado el incidente.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="bg-gray-950/60 border border-gray-800 rounded-xl p-3 text-xs text-gray-400 font-mono">
                ID de Solicitud: <span class="text-brand-400">@Model.RequestId</span>
            </div>
        }

        <div class="pt-2">
            <a asp-page="/Index" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-brand-600 to-brand-700 hover:from-brand-500 hover:to-brand-600 text-white font-semibold rounded-xl transition-all shadow-lg shadow-brand-500/20 space-x-2 text-sm">
                <i class="fa-solid fa-house"></i>
                <span>Volver al Inicio</span>
            </a>
        </div>
    </div>
</div>
